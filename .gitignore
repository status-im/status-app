# issue 0016/0017: the driver's key files. .status-client.key absorbed make's
# .qmake_previous, whose rule died with the client target in 0017 — the entry
# stays so an existing tree's leftover copy is not suddenly untracked.
.qmake_previous
# Used to track the simulated keycard mode changes via the USE_SIMULATED_KEYCARD build flag
.use_simulated_keycard_previous
