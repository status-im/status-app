# statusgo build OUTPUTS (issues 0010, 0020): libstatus + libsds + their
# headers, the generated cbindings entry point, the nimcaches and the two key
# files. No status-go or nim-sds source ever lives here — both are built in
# place from the read-only store copies the resolution names.
/.statusgo-build/
# develop-mode statusgo checkout (issue 0009; materialized by `nim develop status.nims statusgo`)
/vendor/status-go/
# keycard pair (issue 0011): out-of-checkout cmake build tree + develop-mode checkouts
/build/status-keycard-qt/
/vendor/status-keycard-qt/
/vendor/keycard-qt/
# seaqt pair (issue 0012): develop-mode checkouts (`nim develop status.nims seaqt|nimqml`)
/vendor/nim-seaqt/
/vendor/nimqml-seaqt/
# prl-to-pc (issue 0014): repo-local tool build dir (the store copy is
# read-only) + develop-mode checkout
/.prl-to-pc-build/
/vendor/prl-to-pc/
.phase2-vendor-backup/
/.claude/
