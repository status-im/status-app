# Configuration for fastlane match
# match manages iOS code signing certificates and provisioning profiles

# Git repository for storing encrypted certificates and profiles
# - Production certs (adhoc, appstore): status-app-ios-certs.git (restricted, uses MATCH_PASSWORD)
# - Development certs: status-app-ios-dev-certs.git (shareable, uses MATCH_DEV_PASSWORD)
#
# Set MATCH_GIT_URL to override (used by development lane and direct match commands)
git_url(ENV["MATCH_GIT_URL"] || "git@github.com:status-im/status-app-ios-certs.git")

storage_mode("git")

app_identifier([
  "app.status.mobile",
  "app.status.mobile.pr"
])

# App Store Connect API Key
api_key_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"]) if ENV["APP_STORE_CONNECT_API_KEY_PATH"]

# Keychain configuration
keychain_name(ENV["KEYCHAIN_NAME"]) if ENV["KEYCHAIN_NAME"]
keychain_password(ENV["KEYCHAIN_PASSWORD"]) if ENV["KEYCHAIN_PASSWORD"]
