#!/usr/bin/env groovy
library 'status-jenkins-lib@v1.9.52'

pipeline {
  agent {
    dockerfile {
      label 'linuxcontainer'
      filename 'tests.Dockerfile'
      dir 'ci'
      args '--network=host ' +
           '--cap-add=SYS_ADMIN ' +
           '--security-opt=apparmor:unconfined ' +
           '--device=/dev/fuse ' +
           '--group-add docker ' +
           '--volume=/var/run/docker.sock:/var/run/docker.sock ' +
           '--volume=/home/jenkins/.squish-license:/home/jenkins/.squish-license ' +
           '--volume=/opt/squish-runner-9.2.2-qt-6.11:/opt/squish-runner-9.2.2-qt-6.11 ' +
           '--user jenkins'
    }
  }

  triggers {
    cron('TZ=Etc/UTC\nH 4 * * *')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    /* Prevent Jenkins jobs from running forever */
    timeout(time: 180, unit: 'MINUTES')
    /* manage how many builds we keep */
    buildDiscarder(logRotator(
      numToKeepStr: '50',
      daysToKeepStr: '60',
      artifactNumToKeepStr: '10',
      artifactDaysToKeepStr: '30',
    ))
    disableRestartFromStage()
  }

  environment {
    PLATFORM = 'tests/e2e'

    SQUISH_DIR = '/opt/squish-runner-9.2.2-qt-6.11'
    PYTHONPATH = "${SQUISH_DIR}/lib:${SQUISH_DIR}/lib/python:${PYTHONPATH}"
    LD_LIBRARY_PATH = "${SQUISH_DIR}/lib:${SQUISH_DIR}/python3/lib:${LD_LIBRARY_PATH}"

    /* To stop e2e tests using port 8545 */
    STATUS_RUNTIME_HTTP_API = 'False'
    STATUS_RUNTIME_WS_API = 'False'

    /* Avoid race conditions with other builds using virtualenv. */
    VIRTUAL_ENV = "${WORKSPACE_TMP}/venv"
    PATH = "${VIRTUAL_ENV}/bin:${PATH}"

    /* To store user configuratiin files in temp dir */
    XDG_CONFIG_HOME = "${WORKSPACE_TMP}/config"

    /* To remove QML cache */
    QML_DISABLE_CACHE = 1

    /* Override QT xcb plugin with linux to avoid errors like:
     * "Could not load the Qt platform plugin "xcb" in "" even though it was found." */
    QT_QPA_PLATFORM = "linuxfb"

    /* Runtime flag to make testing of the app easier. Helps avoiding banners */
    STATUS_RUNTIME_TEST_MODE = 1

    /* Logging rules let you enable or disable logging for categories */
    QT_LOGGING_RULES = '*.warning=true'

    /* Set to a non-zero value to make Qt print out diagnostic information about the each (C++) plugin it tries to load. */
    /* QT_DEBUG_PLUGINS = 0 */

    /* Use local waku fleet */
    E2E_LOCAL_WAKU_FLEET = '1'
    WAKU_IMAGE = 'quay.io/wakuorg/nwaku-pr:nightly-logosdeliverynode'
    STATUS_FLEET = 'status-app.test'
    STATUS_FLEET_CONFIG_FILE = "${WORKSPACE}/assets/local-waku-fleets-config.json"

    LOG_LEVEL = 'INFO'

  }

  stages {
    stage('Cleanup Workspace') {
      steps {
        sh './scripts/clean-git.sh'
      }
    }
    stage('Fetch submodules') {
      steps {
        sh './scripts/ci-fetch-submodules.sh'
      }
    }
    stage('Deps') {
      steps {
        script { dir('test/e2e') {
          sh "python3 -m venv ${VIRTUAL_ENV}"
          sh 'pip3 install -r requirements.txt'
        } }
        script { dir('test/e2e/scripts/wallet_connect_dapp') {
          sh 'npm ci --no-audit --no-fund'
        } }
      }
    }

    stage('Copy') {
      steps { timeout(5) { script { dir('test/e2e') {
        copyArtifacts(
          projectName: 'status-app/nightly',
          filter:      'pkg/*-x86_64.tar.gz',
          selector:    lastSuccessful(),
          target:      './'
        )
      } } } }
    }

    stage('Unpack') {
      steps { timeout(5) { script { dir('test/e2e') {
        sh 'mkdir aut'
        sh "tar -zxvf '${utils.findFile('pkg/*tar.gz')}' -C './aut'"
        env.AUT_PATH = utils.findFile('aut/*.AppImage')
        env.TESTED_APP = utils.baseName(env.AUT_PATH)
        currentBuild.description = "App: ${env.TESTED_APP}"
      } } } }
    }

    stage('Test') {
      steps {
          script {
            try {
              timeout(10) {
                sh 'docker pull "$WAKU_IMAGE"'
                env.WAKU_IMAGE_ID = sh(
                  script: 'docker image inspect --format "{{.Id}}" "$WAKU_IMAGE"',
                  returnStdout: true,
                ).trim()
                sh '''
                  mkdir -p nightly-report
                  docker image inspect --format 'image={{.Id}} digests={{json .RepoDigests}} created={{.Created}}' "$WAKU_IMAGE" > nightly-report/image.txt
                  cat nightly-report/image.txt
                '''
              }
              timeout(2) {
                /* Clean up any leftover containers from a previous aborted run */
                sh "docker compose -p ${fleetProject()} -f docker-compose.waku.yml down --remove-orphans || true"
                sh "docker compose -p ${fleetProject()} -f docker-compose.waku.yml up -d"
                withEnv(["FLEET_PROJECT=${fleetProject()}"]) {
                  sh '''
                    set -eu
                    for service in boot-1 store store-2; do
                      container=$(docker compose -p "$FLEET_PROJECT" -f docker-compose.waku.yml ps -q "$service")
                      test -n "$container"
                      actual=$(docker inspect --format '{{.Image}}' "$container")
                      printf '%s container=%s image=%s expected=%s\n' "$service" "$container" "$actual" "$WAKU_IMAGE_ID" | tee -a nightly-report/containers.txt
                      test "$actual" = "$WAKU_IMAGE_ID"
                    done
                    echo 'NIGHTLY FLEET VERIFIED: all 3 containers use the pulled image.'
                  '''
                }
                sh 'sleep 15'
                sh "python3 test/e2e/scripts/scan_waku_fleet.py --project ${fleetProject()}"
                sh 'cp "$STATUS_FLEET_CONFIG_FILE" nightly-report/local-waku-fleets-config.json'
                echo "LOCAL WAKU FLEET: ${env.STATUS_FLEET}; config: ${env.STATUS_FLEET_CONFIG_FILE}"
              }
              timeout(time: 120, unit: 'MINUTES') {
                dir('test/e2e') {
                  dir ('configs') { sh 'ln -s _local.ci.py _local.py' }
                  wrap([
                    $class:            'Xvfb',
                    autoDisplayName:   true,
                    parallelBuild:     true,
                    screen:            '2560x1440x24',
                    additionalOptions: '-dpi 1'
                  ]) {
                    sh 'fluxbox &'
                    withCredentials([
                      string(credentialsId: 'wallet-test-user-seed', variable: 'WALLET_TEST_USER_SEED')
                    ]) {
                      sh """
                        python3 -m pytest -m "not (keycard or benchmark)" -v --reruns=1 --timeout=300 \
                          --log-level=INFO --log-cli-level=INFO \
                          --disable-warnings \
                          --alluredir=./allure-results \
                          --junitxml=./reports/junit.xml \
                          -o timeout_func_only=true
                      """
                    }
                  }
                }
              }
            } finally {
              sh 'mkdir -p nightly-report'
              sh "docker compose -p ${fleetProject()} -f docker-compose.waku.yml logs --no-color > nightly-report/fleet.log 2>&1 || true"
              /* Stop local waku fleet */
              sh "docker compose -p ${fleetProject()} -f docker-compose.waku.yml down --remove-orphans || true"
          }
        }
      }
    }
  }

  post {
    always { script {
      catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
        reportGithubIssues()
      }
      archiveArtifacts(artifacts: 'nightly-report/**', allowEmptyArchive: true)
      dir('test/e2e') {
        archiveArtifacts(
          artifacts: 'local_run_results/*.log, reports/*.xml',
          allowEmptyArchive: true,
        )
        junit(
          testResults: 'reports/*.xml',
          allowEmptyResults: true,
          skipOldReports: true,
          skipPublishingChecks: true,
          skipMarkingBuildUnstable: true,
        )

        /* Needed to categorize types of errors and add environment section in allure report. */
        sh 'cp ext/allure_files/categories.json allure-results'
        sh 'cp ext/allure_files/environment.properties allure-results'

        allure([
          results: [[path: 'allure-results']],
          reportBuildPolicy: 'ALWAYS',
          properties: [],
          jdk: '',
        ])
      }
    } }
    cleanup {
      cleanWs(disableDeferredWipeout: true)
      dir(env.WORKSPACE_TMP) { deleteDir() }
    }
  }
}

def reportGithubIssues() {
  writeFile(file: 'nightly-report/issue-report.json',
            text: '{"action":"not-run","message":"See console if credential binding fails."}\n')
  try {
    withEnv(["NIGHTLY_BUILD_RESULT=${currentBuild.currentResult}"]) {
      withCredentials([usernamePassword(credentialsId: 'status-im-auto',
        usernameVariable: 'GH_USERNAME', passwordVariable: 'GH_TOKEN')]) {
        sh '''
          set +x
          python3 scripts/report_nightly_issues.py
        '''
      }
    }
  } finally {
    if (fileExists('nightly-report/issue-url.txt')) {
      def issueUrl = readFile('nightly-report/issue-url.txt').trim()
      currentBuild.description = "${currentBuild.description ?: ''}<br>GitHub issue: ${issueUrl}"
      echo "GITHUB FAILURE ISSUE: ${issueUrl}"
    } else {
      echo 'No issue URL recorded. See nightly-report/issue-report.json and the reporting stage output.'
    }
  }
}

def fleetProject() {
  return "logos-delivery-e2e-${env.BUILD_NUMBER}-${env.EXECUTOR_NUMBER}".toLowerCase()
}
