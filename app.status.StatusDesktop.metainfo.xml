<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.status.StatusDesktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <name>Status</name>
  <summary>Private messenger, crypto wallet and Web3 browser</summary>
  <description>
    <p>
      Status is a secure messaging app, crypto wallet, and Web3 browser built with state of the art technology.
      It's an open source, Ethereum-based app that gives you the power to chat, transact and access a revolutionary
      world of DApps on the decentralized web.
    </p>
    <p>Features:</p>
    <ul>
      <li>Private, encrypted messaging</li>
      <li>Built-in Ethereum wallet</li>
      <li>Web3 DApp browser</li>
      <li>Decentralized network</li>
      <li>Community-driven development</li>
    </ul>
  </description>
  <launchable type="desktop-id">app.status.StatusDesktop.desktop</launchable>
  <provides>
    <binary>nim_status_client_wrapped</binary>
  </provides>
  <url type="homepage">https://status.app</url>
  <url type="bugtracker">https://github.com/status-im/status-app/issues</url>
  <url type="help">https://status.app/help</url>
  <url type="vcs-browser">https://github.com/status-im/status-app</url>
  <developer id="app.status">
    <name>Status Research &amp; Development GmbH</name>
  </developer>
  <branding>
    <color type="primary" scheme_preference="light">#4360df</color>
    <color type="primary" scheme_preference="dark">#1b273d</color>
  </branding>
  <keywords>
    <keyword>messenger</keyword>
    <keyword>chat</keyword>
    <keyword>ethereum</keyword>
    <keyword>wallet</keyword>
    <keyword>web3</keyword>
    <keyword>crypto</keyword>
  </keywords>
  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
    <category>Chat</category>
  </categories>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
