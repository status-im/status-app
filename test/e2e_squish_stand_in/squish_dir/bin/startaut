#!/bin/bash
# Stands in for Squish's startaut: starts the application with the Qt inspector plugin
# listening on the port Squish would have hooked.
# usage: startaut [--verbose] --port=<n> <application> [application arguments]
set -eu
: "${INSPECTOR_PLUGINS:?directory that holds generic/libqmlinspector.so}"
port=""
args=()
for arg in "$@"; do
  case "$arg" in
    --verbose) ;;
    --port=*) if [ -z "$port" ]; then port="${arg#--port=}"; else args+=("$arg"); fi ;;
    *) args+=("$arg") ;;
  esac
done
# Not STATUS_RUNTIME_TEST_MODE: some tests start the app with test mode off on purpose.
export QML_INSPECTOR_ALLOW=1
export QT_PLUGIN_PATH="$INSPECTOR_PLUGINS"
export QT_QPA_GENERIC_PLUGINS="qmlinspector:$port"
exec "${args[@]}"
