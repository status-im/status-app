#!/usr/bin/env python3
"""Stands in for squishserver.

The suite uses it in two ways: to register an application (`--config=addAttachableAUT
<id> <host>:<port>`), and as a long-running server whose port it waits for.
"""
import os
import socket
import sys
import tempfile

STATE_DIR = os.environ.get("SQUISH_STAND_IN_STATE", os.path.join(tempfile.gettempdir(), "squish-stand-in"))

args = sys.argv[1:]
if "--config=addAttachableAUT" in args:
    aut_id, address = args[-2], args[-1]
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(os.path.join(STATE_DIR, aut_id), "w") as port_file:
        port_file.write(address.rsplit(":", 1)[1])
    sys.exit(0)

port = next(int(arg.split("=", 1)[1]) for arg in args if arg.startswith("--port="))
server = socket.socket()
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind(("127.0.0.1", port))
server.listen()
while True:
    connection, _ = server.accept()
    connection.close()
